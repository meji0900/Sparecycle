# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sparecycle
.recon/
.check/
.check-live/
.keys/
data/
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/*/dry-run/
node-client/.venv/
node-client/models/
node-client/bin/
*.db
*.db-wal
*.db-shm
.next-*/
!.env.example

# hyperframes video projects: keep the source, not the renders
videos/*/renders/
videos/*/.hyperframes/
videos/*/snapshots/
videos/*/node_modules/

# GPU agreement bench outputs (node-client bench): local scratch. Published results live in bench/ (committed).
.bench/
node-client/bench-*/

# Off-server copies of payout trees (scripts/backup-trees.mjs)
backups/
