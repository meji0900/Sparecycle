# Sparecycle environment. Copy to .env.local (never committed).
# Every value here is a placeholder from the build brief. Leave it empty until it is real:
# the site fails closed ("Not configured" / "Not deployed yet"), it never invents a value.
# On Railway: railway variable set --service web KEY=value   (secrets: ... KEY --stdin)
# NEXT_PUBLIC_* values are baked in at build time: set them before the deploy that needs them.

# --- Network ---
# mainnet = Robinhood Chain (4663) | testnet = Robinhood Chain Testnet (46630) | local = anvil (31337)
NEXT_PUBLIC_NETWORK=mainnet
# Empty = the chain's public RPC (rate-limited). Use a dedicated provider in production.
NEXT_PUBLIC_RPC_URL=
# Empty = Blockscout for the selected network.
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WalletConnect Cloud project id (empty = browser-extension wallets only).
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Token (exists only after the Pons launchToken transaction confirms) ---
NEXT_PUBLIC_TICKER=
NEXT_PUBLIC_TOKEN_ADDRESS=
# Resolved from the factory's getLaunchedToken(token).curve when empty.
NEXT_PUBLIC_CURVE_ADDRESS=
# Read live; the docs' example is 0, do not assume it stays correct.
NEXT_PUBLIC_LAUNCH_CONFIG_ID=

# --- Open product decisions (brief §1). Decide before mainnet; do not guess. ---
# ETH | USDG
NEXT_PUBLIC_PAIR_ASSET=
# 0x0000000000000000000000000000000000000000 for ETH; USDG only if approved
NEXT_PUBLIC_PAIR_TOKEN_ADDRESS=
# 0 or another value <= live maxCreatorTaxBps(); cannot be raised after launch
NEXT_PUBLIC_CREATOR_TAX_BPS=
# ETH | USDG | TOKEN
NEXT_PUBLIC_NODE_PAYOUT_ASSET=

# --- Deployments and operators ---
NEXT_PUBLIC_REWARD_CONTRACT_ADDRESS=
# Owner of the reward contract (set by scripts/mainnet.mjs env). A single wallet unless it equals the multisig.
NEXT_PUBLIC_OWNER_ADDRESS=
NEXT_PUBLIC_MULTISIG_ADDRESS=
NEXT_PUBLIC_SCHEDULER_ADDRESS=
NEXT_PUBLIC_SWEEP_BOT_ADDRESS=
# Read by scripts/prelaunch-check.mjs (canLaunch).
LAUNCHER_WALLET=

# --- Scheduler (runs inside this Next.js service) ---
# Empty = this app's own /api/v1
NEXT_PUBLIC_SCHEDULER_API_URL=
# Epoch length in seconds (must match the reward contract)
NEXT_PUBLIC_EPOCH_LENGTH=
# Empty = unclaimed reserved amounts stay claimable indefinitely
NEXT_PUBLIC_CLAIM_WINDOW=
# SQLite file. On Railway put it on the volume: /data/sparecycle.db
DB_PATH=./data/sparecycle.db
# Jobs per IP per hour
JOB_RATE_LIMIT=
# Private job outputs (docs/private-outputs.md): off (default) | enforce. enforce = only the job's read secret
# or the paying wallet's sign-in can read an output; the old /output URL answers 410
OUTPUT_AUTH=
# Output reads per viewer per hour (default 600)
OUTPUT_RATE_LIMIT=
# Sign-in message domain(s), comma-separated, e.g. sparecycle.tech (empty = the host the request was sent to)
AUTH_DOMAIN=
# 1 = close epochs on a timer inside the web process
SCHEDULER_AUTOCLOSE=
# Bearer token for POST /api/v1/epochs/close (secret)
SCHEDULER_ADMIN_TOKEN=
# Private key allowed to post Merkle roots (secret; type it with --stdin, never paste it in chat)
SCHEDULER_SIGNER_KEY=
# Optional cap, wei per work unit (empty = no cap; unused pot rolls over)
PAYOUT_CAP_PER_UNIT=
# Local end-to-end tests only. Never set in production.
SCHEDULER_ALLOW_DEV_RUNNER=

# --- x402 pay-per-job (docs/x402-decision.md). INTERNAL REVIEW ONLY — NOT EXTERNALLY AUDITED. Capped launch. ---
# 1 = accept x402 payments on /v1/chat/completions and /v1/images/generations from requests without an API key.
# Off when empty. Needs every value below plus SCHEDULER_SIGNER_KEY, and a passing preflight against the escrow.
X402_ENABLED=
# SparecycleX402Escrow (contracts/script/DeployX402Escrow.s.sol). Never guess: the deploy script prints it.
X402_ESCROW_ADDRESS=
# The EIP-3009 payment asset and its EIP-712 domain (checked against its DOMAIN_SEPARATOR at boot)
X402_ASSET_ADDRESS=
X402_ASSET_NAME=
X402_ASSET_VERSION=
# Price per work unit in the asset's smallest unit (USDG: 6 decimals). A decision: no default.
X402_PRICE_PER_UNIT=
# How long a payment authorization may be valid, 60..3600 s (default 300)
X402_MAX_TIMEOUT_SECONDS=
# Optional third-party /verify in front of the local checks (https only). Leave empty on mainnet.
X402_FACILITATOR_URL=

# --- Sweep / claim bot ---
SWEEP_ENABLED=
SWEEP_SIGNER_KEY=
SWEEP_POOL_ID=
# Always-on sweep inside the web server: every N minutes (>= 5; unset = off). Needs SWEEP_SIGNER_KEY.
SWEEP_AUTORUN_MINUTES=
# Discord or Slack incoming webhook: a message whenever sweep problems or low bot gas appear or clear.
ALERT_WEBHOOK_URL=
# Support form on /docs/support: a Discord or Slack incoming webhook (https). Empty = the form is shown disabled and
# POST /api/support answers 503. Messages are forwarded, never stored by the site.
SUPPORT_WEBHOOK_URL=
# Daily SQLite snapshots next to the DB (<db dir>/backups). Hours between snapshots (default 24, 0 = off), copies kept.
DB_BACKUP_HOURS=
DB_BACKUP_KEEP=

# --- Bootstrap GPU pool (optional): the project's own Vast.ai GPU nodes, started on demand ---
# Started when jobs wait and fewer than two owners online can take them; stopped after GPU_POOL_IDLE_MINUTES
# without open jobs. VAST_API_KEY is a secret: type it with `railway variable set VAST_API_KEY --stdin`.
VAST_API_KEY=
GPU_POOL_INSTANCE_IDS=
# Pool machines that are never stopped (must also be in GPU_POOL_INSTANCE_IDS): one owner kept online, so a start
# needs only the other owner's machine. Costs the full hourly price of that machine.
GPU_POOL_ALWAYS_ON=
GPU_POOL_IDLE_MINUTES=10
# Owner wallets of project-run nodes (comma-separated): never paid, marked "Run by Sparecycle" on /app.
# `node scripts/pool-owners.mjs init` prints the two pool owners.
PROJECT_NODE_OWNERS=

# --- Measured later, not invented ---
EPOCH_POST_GAS_COST=

# --- Legal and links (empty = labelled placeholder on the site) ---
NEXT_PUBLIC_TOS_URL=
NEXT_PUBLIC_TOS_VERSION=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DOMAIN=
LEGAL_REVIEW=
