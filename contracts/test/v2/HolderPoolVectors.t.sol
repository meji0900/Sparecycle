pragma solidity ^0.8.28;

import {MerkleProof} from "@openzeppelin/contracts/utils/cryptography/MerkleProof.sol";
import {V2Fixture} from "./V2Fixture.sol";

/// @notice The scheduler's holder roots (src/server/holders.ts) against the real SparecycleHolderPool: the vectors in
///         test/fixtures/holder-pool-vectors.json are generated by src/server/holder-vectors.test.ts (which fails when they
///         drift from the TypeScript code). Each case: the floored split of the funding by weight, the leaf rule, every
///         proof against the root, then postRoot from the scheduler and a credit-mode claim of every leaf with the
///         TypeScript proof, which must add exactly the amount as spend-only credits in V2.
contract HolderPoolVectorsTest is V2Fixture {
    struct Case {
        uint64 epochId;
        uint256 funded;
        uint256 total;
        bytes32 root;
        address[] holders;
        uint256[] weights;
        uint256[] modes;
        uint256[] amounts;
        bytes32[] leaves;
    }

    string internal json;

    function setUp() public override {
        super.setUp();
        json = vm.readFile(string.concat(vm.projectRoot(), "/test/fixtures/holder-pool-vectors.json"));
    }

    function _key(uint256 c, string memory field) internal pure returns (string memory) {
        return string.concat(".cases[", vm.toString(c), "].", field);
    }

    function _count() internal view returns (uint256 n) {
        while (vm.keyExistsJson(json, string.concat(".cases[", vm.toString(n), "]"))) ++n;
    }

    function _load(uint256 c) internal view returns (Case memory k) {
        k.epochId = uint64(vm.parseJsonUint(json, _key(c, "epochId")));
        k.funded = vm.parseJsonUint(json, _key(c, "funded"));
        k.total = vm.parseJsonUint(json, _key(c, "total"));
        k.root = vm.parseJsonBytes32(json, _key(c, "root"));
        k.holders = vm.parseJsonAddressArray(json, _key(c, "holders"));
        k.weights = vm.parseJsonUintArray(json, _key(c, "weights"));
        k.modes = vm.parseJsonUintArray(json, _key(c, "modes"));
        k.amounts = vm.parseJsonUintArray(json, _key(c, "amounts"));
        k.leaves = vm.parseJsonBytes32Array(json, _key(c, "leaves"));
    }

    function _proof(uint256 c, uint256 i) internal view returns (bytes32[] memory) {
        return vm.parseJsonBytes32Array(json, string.concat(_key(c, "proofs"), "[", vm.toString(i), "]"));
    }

    function test_Vectors_SplitLeavesAndProofs() public view {
        uint256 n = _count();
        assertEq(n, 3, "three cases");
        for (uint256 c; c < n; ++c) {
            Case memory k = _load(c);
            uint256 sumW;
            for (uint256 i; i < k.weights.length; ++i) {
                sumW += k.weights[i];
            }
            uint256 sum;
            for (uint256 i; i < k.holders.length; ++i) {
                assertEq(k.amounts[i], k.funded * k.weights[i] / sumW, "amount = floor(funded x weight / total weight)");
                assertEq(k.modes[i], pool.MODE_CREDITS(), "credit mode");
                assertEq(pool.leafOf(k.epochId, k.holders[i], uint8(k.modes[i]), k.amounts[i]), k.leaves[i], "leaf rule");
                assertTrue(MerkleProof.verify(_proof(c, i), k.root, k.leaves[i]), "proof verifies");
                sum += k.amounts[i];
            }
            assertEq(sum, k.total, "totalEth = sum of the leaves");
            assertLe(k.total, k.funded);
            assertLt(k.funded - k.total, k.holders.length, "remainder below one wei per holder");
        }
    }

    function test_Vectors_PostRootAndClaimAsCredits() public {
        uint256 n = _count();
        // Close epochs up to the highest case, so every case's epoch is closed and postable in order.
        uint64 last;
        for (uint256 c; c < n; ++c) {
            uint64 id = _load(c).epochId;
            if (id > last) last = id;
        }
        while (ethR.currentEpoch() <= last) _closeEmpty(ethR);

        for (uint256 c; c < n; ++c) {
            Case memory k = _load(c);
            vm.prank(funder);
            pool.fund{value: k.funded}();
            uint256 availBefore = pool.available();
            vm.prank(sched);
            pool.postRoot(k.epochId, k.root, k.total);
            assertEq(pool.available(), availBefore - k.total, "the root reserves exactly totalEth; the remainder stays available");
            for (uint256 i; i < k.holders.length; ++i) {
                _claimOne(k, i, _proof(c, i));
            }
            assertEq(pool.getRoot(k.epochId).claimed, k.total);
        }
    }

    function _claimOne(Case memory k, uint256 i, bytes32[] memory proof) internal {
        address h = k.holders[i];
        uint256 creditBefore = pay.creditOf(h);
        vm.prank(h);
        pool.claim(k.epochId, uint8(k.modes[i]), k.amounts[i], proof);
        assertEq(pay.creditOf(h) - creditBefore, k.amounts[i], "claimed as spend-only credits");
        assertEq(pay.balanceOf(h), 0, "nothing withdrawable");
        assertTrue(pool.hasClaimed(k.epochId, h));
    }
}
